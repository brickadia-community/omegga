{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": [
      "./src/index.d.ts",
      "../src/webserver/backend/types.d.ts",
      /* ambient module declarations for untyped backend deps */
      "../src/omegga/plugin/disrequire.d.ts",
      "../src/updater/steam-acf2json.d.ts",
      "../src/webserver/backend/better-sqlite3-session-store.d.ts",
      "../src/update-notifier-cjs.d.ts"
    ],
    "paths": {
      "@components": [
        "./src/components"
      ],
      "@utils": [
        "./src/utils"
      ],
      "@hooks": [
        "./src/hooks"
      ],
      "@backend/*": [
        "../src/webserver/backend/*"
      ],
      /* Backend path aliases - mirrored here so tRPC can resolve backend types */
      "@omegga/*": [
        "../src/omegga/*"
      ],
      "@/*": [
        "../src/*"
      ],
      "@util/*": [
        "../src/util/*"
      ],
      "@util": [
        "../src/util/index.ts"
      ],
      "@config/*": [
        "../src/config/*"
      ],
      "@config": [
        "../src/config/index.ts"
      ],
      "@brickadia/*": [
        "../src/brickadia/*"
      ],
      "@webserver/*": [
        "../src/webserver/*"
      ],
      "@cli/*": [
        "../src/cli/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}